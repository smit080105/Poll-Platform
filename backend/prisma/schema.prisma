generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  ORGANIZER
}

enum PollType {
  SINGLE_CHOICE
}

enum PollStatus {
  DRAFT
  ACTIVE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(PARTICIPANT)
  createdAt DateTime @default(now())
  polls     Poll[]   @relation("CreatedPolls")
  votes     Vote[]
}

model Poll {
  id          String   @id @default(uuid())
  shortId     String   @unique
  title       String
  description String   @default("")
  type        PollType @default(SINGLE_CHOICE)
  startDate   DateTime
  endDate     DateTime
  maxVotes    Int?
  isPublic    Boolean  @default(true)
  status      PollStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  organizer   User     @relation("CreatedPolls", fields: [organizerId], references: [id])
  organizerId String
  options     Option[]
  votes       Vote[]
}

model Option {
  id     String @id @default(uuid())
  text   String
  poll   Poll   @relation(fields: [pollId], references: [id])
  pollId String
  votes  Vote[]

  @@unique([id, pollId])
}

model Vote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  poll      Poll     @relation(fields: [pollId], references: [id])
  pollId    String
  option    Option   @relation(fields: [optionId, pollId], references: [id, pollId])
  optionId  String
  createdAt DateTime @default(now())

  @@unique([userId, pollId])
  @@index([pollId])
}