# ============================================
# PollWave Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection string (start the dev database with Docker Compose)
DATABASE_URL="postgresql://pollwave:pollwave_dev@localhost:5432/pollwave_dev"

# JWT secret — CHANGE THIS IN PRODUCTION!
JWT_SECRET="your-secret-key-here"

# Organizer accounts require this shared registration code.
# Leave unset to disable public organizer registration.
ORGANIZER_SIGNUP_CODE=""

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"
